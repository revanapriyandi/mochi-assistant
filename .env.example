AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://context-assistant-api
# any long random string, e.g. output of: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=
BASE_URL=http://localhost:3000
# Claude API key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Free brain: Groq (key: https://console.groq.com, no card needed). Used when ANTHROPIC_API_KEY is empty.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Mochi's voice: ElevenLabs (https://elevenlabs.io, free tier). Without a key Mochi replies in text only.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_SPEED=1   (0.7-1.2, scales how fast Mochi talks)
# PLANNER_MODEL=   (defaults to GROQ_MODEL)

# Chat history in a Tiger Data (TimescaleDB) hypertable; without it, history is in memory (lost on restart).
# DATABASE_URL=postgres://tsdbadmin:...@xxxx.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require

# The veto: approval for deletes via Auth0 CIBA. <=300 s = Guardian push, 301-259200 s = email channel.
# CIBA_EXPIRY=300

# Photo-real avatar (optional, https://app.simli.com). Without these Mochi is the built-in 2D cat.
SIMLI_API_KEY=
SIMLI_FACE_ID=
