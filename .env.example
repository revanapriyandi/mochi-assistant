AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://context-assistant-api
# any long random string, e.g. output of: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=
BASE_URL=http://localhost:3000
# Claude API key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Free LLM via any OpenAI-compatible API. Default: Google Gemini (key: https://aistudio.google.com/apikey)
LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.8-flash
# Free fallback when Gemini fails or hits its quota (key: https://console.groq.com, no card needed)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Mochi's voice: ElevenLabs (https://elevenlabs.io, free tier). Without a key Mochi replies in text only.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_SPEED=1   (0.7-1.2, scales how fast Mochi talks)
# PLANNER_MODEL=   (defaults to LLM_MODEL)

# Photo-real avatar (optional, https://app.simli.com). Without these Mochi is the built-in 2D cat.
SIMLI_API_KEY=
SIMLI_FACE_ID=
